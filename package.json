{
  "name": "@jasper_alaric/dsh-hybrid-memory",
  "version": "1.0.5",
  "description": "Transparent Markdown long-term memory for DeepSeek Harness: tiered facts, background extraction, BM25 search, persona editing, and a heartbeat.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "markdown",
    "bm25",
    "persona",
    "heartbeat"
  ],
  "license": "MIT",
  "author": "jasper_alaric",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.png",
    "docs/*.svg",
    "docs/registry-entry.json",
    "docs/awesome-dsh-plugin.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonenameless/dsh-hybrid-memory.git"
  },
  "homepage": "https://github.com/nonenameless/dsh-hybrid-memory#readme",
  "bugs": {
    "url": "https://github.com/nonenameless/dsh-hybrid-memory/issues"
  }
}
